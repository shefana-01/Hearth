# ── Offline demo (default) ───────────────────────────────────────────────────
# "true" serves every request from src/mocks, in the browser. No backend needed.
VITE_USE_MOCKS=true

# Simulated network latency for mock responses, in milliseconds. Screens make several calls, so
# keep this low (100–150) or every page feels slow; raise it only to demo loading states.
VITE_MOCK_LATENCY_MS=120

# Currency for shopping-list prices and the weekly budget (ISO 4217 code).
VITE_CURRENCY=BDT

# ── Connected to the Hearth backend ──────────────────────────────────────────
# Start the backend (`docker compose up --build` in the repository root; see backend/README.md),
# then put these two lines in .env.local and run `npm run dev`:
#   VITE_USE_MOCKS=false
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=
