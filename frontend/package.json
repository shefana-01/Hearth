{
  "name": "hearth-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hearth \u2014 family care coordination platform (web frontend)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
