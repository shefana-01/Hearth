# Settings for `docker compose up`. Copy this file to `.env` (next to docker-compose.yml) and change what
# you need. Everything has a working default, so the file is optional for trying Hearth on your computer.
# `.env` is in .gitignore: never commit real passwords.

# Password of the PostgreSQL user "hearth" (all six service databases).
DB_PASSWORD=change-me

# Password of the Neo4j user "neo4j" (the family map).
NEO4J_PASSWORD=change-me-too

# Where people open Hearth. Used for the links in emails (confirm email, reset password, invitations).
APP_URL=http://localhost:8000

# Web addresses allowed to call the API from a browser, comma-separated. Only needed for `npm run dev`
# (the Docker web app on port 8000 talks to the API through the same address).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# true: also show people the family-wide notifications about what they did themselves (handy when you
# test alone with one account). false in normal use.
NOTIFY_OWN_ACTIONS=false
